{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "ignore": ["node_modules", "dist", "coverage", "tmp", ".litepacks-release-tools", ".github", "package-lock.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noUnusedTemplateLiteral": "off",
        "useDefaultParameterLast": "off",
        "useTemplate": "off",
        "noArguments": "off"
      },
      "complexity": {
        "noForEach": "off",
        "useOptionalChain": "off",
        "noBannedTypes": "off"
      },
      "performance": {
        "noDelete": "off"
      },
      "suspicious": {
        "noEmptyBlockStatements": "off",
        "noAssignInExpressions": "off",
        "noExplicitAny": "off",
        "noControlCharactersInRegex": "off",
        "noGlobalIsNan": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "none",
      "semicolons": "always"
    }
  }
}
